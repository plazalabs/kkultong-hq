#!/usr/bin/env python3
"""kkultong-dash CLI 진입점.

사용법:
    ./kkultong-dash run [--full] [--dry-run] [--env-file PATH] [--db PATH]
    ./kkultong-dash check-config [--env-file PATH]
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path
from typing import Optional

REPO_ROOT = Path(__file__).resolve().parent
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from kkultong_dash import __version__
from kkultong_dash.config import AppConfig, load_dotenv
from kkultong_dash.notion_client import NotionAPIError, ReadOnlyGuardError
from kkultong_dash.runner import EXIT_FAILURE, run_dashboard_update


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="kkultong-dash",
        description="꿀통 대시보드 P1 (MVP) — 노션 DB를 읽어 현황 대시보드 페이지를 자동 갱신합니다.",
    )
    parser.add_argument("--version", action="version", version=f"kkultong-dash {__version__}")

    subparsers = parser.add_subparsers(dest="command", required=True)

    run_cmd = subparsers.add_parser("run", help="노션 DB를 읽고 대시보드 페이지를 즉시 갱신합니다.")
    run_cmd.add_argument(
        "--full",
        action="store_true",
        help="증분 동기화를 건너뛰고 두 DB를 전체 재동기화합니다.",
    )
    run_cmd.add_argument(
        "--dry-run",
        action="store_true",
        help="노션 DB를 읽어 집계 결과만 출력하고 대시보드 페이지에는 쓰지 않습니다.",
    )
    run_cmd.add_argument(
        "--env-file",
        type=Path,
        default=None,
        help="읽을 .env 파일 경로 (기본값: 현재 디렉터리 또는 저장소 루트의 .env)",
    )
    run_cmd.add_argument(
        "--db",
        type=Path,
        default=None,
        help="로컬 SQLite 캐시 DB 경로 오버라이드",
    )

    check_cmd = subparsers.add_parser(
        "check-config",
        help="환경변수 및 .env 설정 상태를 점검합니다(토큰 값은 출력하지 않음).",
    )
    check_cmd.add_argument(
        "--env-file",
        type=Path,
        default=None,
        help="점검할 .env 파일 경로",
    )

    return parser


def main(argv: Optional[list[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    loaded_env = load_dotenv(env_file=args.env_file, repo_root=REPO_ROOT)

    if args.command == "check-config":
        cfg = AppConfig.from_env(repo_root=REPO_ROOT, require_token=False)
        print(f"env 파일: {loaded_env if loaded_env else '(미사용 — 프로세스 환경변수만 사용)'}")
        for key, val in cfg.safe_summary().items():
            print(f"  {key}: {val}")
        if not cfg.notion_token:
            print("상태: 대기 중 — NOTION_TOKEN 미설정", file=sys.stderr)
            return EXIT_FAILURE
        print("상태: 설정 확인 완료 (실제 API 권한 검증은 ./kkultong-dash run 실행 시 확인)")
        return 0

    if args.command == "run":
        try:
            cfg = AppConfig.from_env(
                repo_root=REPO_ROOT,
                db_path_override=args.db,
                require_token=True,
            )
        except ValueError as exc:
            print(f"[설정 오류] {exc}", file=sys.stderr)
            return EXIT_FAILURE

        try:
            outcome = run_dashboard_update(
                cfg,
                force_full=args.full,
                dry_run=args.dry_run,
            )
        except (NotionAPIError, ReadOnlyGuardError) as exc:
            print(f"[실행 실패] {exc}", file=sys.stderr)
            return EXIT_FAILURE

        print(outcome.summary_text)
        if outcome.publish_result is not None:
            pr = outcome.publish_result
            action = "신규 생성" if pr.created_page else "기존 페이지 갱신"
            print(
                f"발행 완료 ({action}): dashboard_page_id={pr.dashboard_page_id} | "
                f"보존된 수동 블록={pr.preserved_manual_blocks}개 | "
                f"삭제된 자동 블록={pr.deleted_auto_blocks}개 | "
                f"추가된 블록={pr.appended_blocks}개"
            )
        elif args.dry_run:
            print("[dry-run] 노션 페이지 쓰기를 생략했습니다.")
        return outcome.exit_code

    return EXIT_FAILURE


if __name__ == "__main__":
    raise SystemExit(main())
